# LLM backend for the conversational art agent.
# Copy to .env.local and fill in a key. The adapter is OpenAI-compatible, so the
# same code works across providers — just switch LLM_PROVIDER (and the key).

# Which provider preset to use: gemini | openai | groq | openrouter
# Default is gemini (free tier, OpenAI-compatible endpoint).
LLM_PROVIDER=gemini

# Your API key for the chosen provider. Required.
#   gemini     -> https://aistudio.google.com/apikey   (free tier)
#   groq       -> https://console.groq.com/keys        (free tier)
#   openrouter -> https://openrouter.ai/keys           (has :free models)
#   openai     -> https://platform.openai.com/api-keys (paid)
LLM_API_KEY=

# Optional overrides. Leave blank to use the preset's default base URL / model.
# LLM_BASE_URL=
# LLM_MODEL=

# --- Semantic retrieval / RAG (optional) ---
# The agent can search the painting library by meaning (story, mood, brushwork)
# instead of just keywords. Corpus vectors are precomputed offline with
# `npm run embed` and committed (src/infrastructure/llm/embeddings.json); at
# runtime only the user's query is embedded. RAG is optional — with no embedding
# key the agent falls back to the keyword matcher.
#
# The embedder is resolved INDEPENDENTLY of the chat model (Groq/OpenRouter have
# no embeddings API), defaulting to Gemini's free embedding model. Each
# LLM_EMBED_* var falls back to its LLM_* counterpart when unset.
# LLM_EMBED_PROVIDER=gemini
# LLM_EMBED_API_KEY=
# LLM_EMBED_MODEL=gemini-embedding-001
# LLM_EMBED_BASE_URL=
# Output vector size (Matryoshka truncation). Smaller = smaller committed file.
# LLM_EMBED_DIMENSIONS=768
# Optional cosine floor for the search_paintings tool: hits below it are dropped
# so off-topic questions return "nothing relevant" instead of weak matches. Off
# by default (the score gap is model-specific); ≈0.5 suits gemini-embedding-001.
# Does NOT affect painting selection. LLM_RAG_MIN_SCORE=0.5

# --- Cost / sampling guardrails (optional) ---
# Cap output tokens per model call. Blank = provider default.
# LLM_MAX_OUTPUT_TOKENS=1024
# Sampling temperature, 0..2. Lower = more deterministic. Blank = provider default.
# LLM_TEMPERATURE=0.6
# Stop a single turn's tool loop once cumulative tokens hit this budget. 0 = off.
# LLM_TURN_TOKEN_BUDGET=8000

# --- Rate limiting ---
# Burst size per client and sustained refill rate (tokens/sec).
# RATE_LIMIT_CAPACITY=12
# RATE_LIMIT_REFILL_PER_SEC=0.5
# Max simultaneous in-flight agent turns.
# MAX_CONCURRENT_TURNS=4
#
# Optional: set BOTH to use Upstash Redis for GLOBAL (cross-instance) rate
# limiting instead of per-instance. Get them from your Upstash database's
# "REST API" panel (https://console.upstash.com). Falls back to in-process if
# unset; fails open if Redis is unreachable.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
